# Supabase project credentials (SAFE to expose in frontend: this is the public anon key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-annon-key

# Public site URL used by the dynamic QR code component.
# On Netlify this can be left unset - the app falls back to window.location.origin automatically.
VITE_SITE_URL=https://localhost:5173

# NEVER put the Supabase service_role key in this file or anywhere in frontend code.
